# Copy this file to .env.local and fill in real values (see supabase.ts
# for how these are consumed). .env.local is gitignored; this file is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Tasting writes (Phase 4) -- LOCAL DEV / E2E ONLY -----------------------
# Saving ratings/notes is off unless BOTH are set, and is always off on
# Vercel regardless (no sign-in until Phase 7). Never add these to Vercel.
# The service-role key bypasses RLS: keep it out of git and out of any
# NEXT_PUBLIC_ variable.
# TASTING_WRITES_ENABLED=true
# SUPABASE_SERVICE_ROLE_KEY=
