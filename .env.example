# Copy this file to .env.local and fill in real values (see supabase.ts
# for how these are consumed). .env.local is gitignored; this file is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the site URL used in sign-up / password-reset email links.
# Defaults to the Vercel production domain, or the request host locally.
# NEXT_PUBLIC_SITE_URL=https://tiki-adventure-app-beige.vercel.app
